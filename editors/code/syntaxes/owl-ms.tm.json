{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OWL Manchester Syntax",
  "scopeName": "source.manchester",
  "patterns": [
    {
      "include": "#string"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#prefix-declaration"
    },
    {
      "include": "#frame-headers"
    },
    {
      "include": "#section-keywords"
    },
    {
      "include": "#full-iri"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#blank-node"
    },
    {
      "include": "#abbreviated-iri"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.manchester"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.manchester",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.manchester"
        }
      ]
    },
    "language-tag": {
      "match": "@[A-Za-z]+(?:-[A-Za-z0-9]+)*",
      "name": "constant.language.language-tag.manchester"
    },
    "prefix-declaration": {
      "match": "(?<![\\w.\\-])(Prefix:)[ \\t]*((?:[A-Za-z][\\w.\\-]*)?:)",
      "captures": {
        "1": {
          "name": "keyword.control.section.manchester"
        },
        "2": {
          "name": "entity.name.namespace.manchester"
        }
      }
    },
    "frame-headers": {
      "patterns": [
        {
          "match": "(?<![\\w.\\-])(Class:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "entity.name.type.class.manchester"
            }
          }
        },
        {
          "match": "(?<![\\w.\\-])(Datatype:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "entity.name.type.datatype.manchester"
            }
          }
        },
        {
          "match": "(?<![\\w.\\-])(ObjectProperty:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "variable.other.property.object-property.manchester"
            }
          }
        },
        {
          "match": "(?<![\\w.\\-])(DataProperty:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "variable.other.property.data-property.manchester"
            }
          }
        },
        {
          "match": "(?<![\\w.\\-])(AnnotationProperty:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "variable.other.property.annotation-property.manchester"
            }
          }
        },
        {
          "match": "(?<![\\w.\\-])(Individual:)[ \\t]*(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.frame.manchester"
            },
            "2": {
              "name": "variable.other.constant.individual.manchester"
            }
          }
        }
      ]
    },
    "section-keywords": {
      "match": "(?<![\\w.\\-])(?:Prefix|Ontology|Import|Annotations|Datatype|Class|ObjectProperty|DataProperty|AnnotationProperty|Individual|EquivalentTo|SubClassOf|DisjointWith|DisjointUnionOf|HasKey|Domain|Range|SubPropertyOf|InverseOf|SubPropertyChain|Characteristics|Types|Facts|SameAs|DifferentFrom|EquivalentClasses|DisjointClasses|EquivalentProperties|DisjointProperties|SameIndividual|DifferentIndividuals):",
      "name": "keyword.control.section.manchester"
    },
    "full-iri": {
      "match": "<[A-Za-z][A-Za-z0-9+\\-.]*:[^\\s<>\"{}|\\\\^`]*>",
      "name": "string.other.link.iri.manchester"
    },
    "blank-node": {
      "match": "_:[\\w.\\-]*\\w",
      "name": "variable.other.blank-node.manchester"
    },
    "abbreviated-iri": {
      "match": "(?<![\\w.\\-:])((?:[A-Za-z][\\w.\\-]*)?:)([\\w\\-]+(?:\\.+[\\w\\-]+)*)",
      "name": "meta.iri.abbreviated.manchester",
      "captures": {
        "1": {
          "name": "entity.name.namespace.manchester"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![\\w.\\-])[+-]?(?:\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?)[fF](?![\\w.\\-:])",
          "name": "constant.numeric.float.manchester"
        },
        {
          "match": "(?<![\\w.\\-])[+-]?\\d+\\.\\d+(?![\\w.\\-:])",
          "name": "constant.numeric.decimal.manchester"
        },
        {
          "match": "(?<![\\w.\\-])[+-]?\\d+(?![\\w.\\-:])",
          "name": "constant.numeric.integer.manchester"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![\\w.:\\-])(?:and|or|not|that)(?![\\w.:\\-])",
          "name": "keyword.operator.logical.manchester"
        },
        {
          "match": "(?<![\\w.:\\-])(?:some|only|value|min|max|exactly|Self|inverse)(?![\\w.:\\-])",
          "name": "keyword.operator.restriction.manchester"
        },
        {
          "match": "(?<![\\w.:\\-])(?:Functional|InverseFunctional|Reflexive|Irreflexive|Symmetric|Asymmetric|Transitive)(?![\\w.:\\-])",
          "name": "storage.modifier.characteristic.manchester"
        },
        {
          "match": "(?<![\\w.:\\-])(?:length|minLength|maxLength|pattern|langRange)(?![\\w.:\\-])",
          "name": "keyword.operator.facet.manchester"
        },
        {
          "match": "(?<![\\w.:\\-])(?:integer|decimal|float|string)(?![\\w.:\\-])",
          "name": "support.type.datatype.manchester"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\^\\^",
          "name": "keyword.operator.datatype.manchester"
        },
        {
          "include": "#language-tag"
        },
        {
          "match": "<=|>=|<|>",
          "name": "keyword.operator.comparison.manchester"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.manchester"
        },
        {
          "match": "[{}\\[\\]()]",
          "name": "punctuation.bracket.manchester"
        }
      ]
    }
  }
}